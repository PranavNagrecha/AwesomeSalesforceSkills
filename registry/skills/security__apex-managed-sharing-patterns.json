  "description": "Grant row-level access programmatically via __Share records when declarative sharing rules cannot express the policy. NOT for OWD, role hierarchy, or criteria-based sharing rule design \u2014 use admin/sharing-and-visibility.",
  "file_location": "skills/security/apex-managed-sharing-patterns",
  "id": "security/apex-managed-sharing-patterns",
  "inputs": [
    "Target SObject",
    "policy rule describing who sees the record and why"
  ],
  "name": "apex-managed-sharing-patterns",
