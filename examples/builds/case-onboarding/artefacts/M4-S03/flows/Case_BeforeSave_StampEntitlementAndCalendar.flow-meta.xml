<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Assignment_Case_Entitlement</name>
        <label>Stamp the account entitlement on the Case</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.EntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Active_Entitlement.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Case_Calendar</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_Case_Calendar_EMEA</name>
        <label>Stamp the EMEA support calendar on the Case</label>
        <locationX>50</locationX>
        <locationY>710</locationY>
        <assignmentItems>
            <assignToReference>$Record.BusinessHoursId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_EMEA_Support_Calendar.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Derive_Priority</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_Case_Calendar_US</name>
        <label>Stamp the US support calendar on the Case</label>
        <locationX>300</locationX>
        <locationY>710</locationY>
        <assignmentItems>
            <assignToReference>$Record.BusinessHoursId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_US_Support_Calendar.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Derive_Priority</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assignment_Priority_High</name>
        <label>Set Priority High for a Severity 1 or Premier case</label>
        <locationX>50</locationX>
        <locationY>950</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assignment_Priority_Medium</name>
        <label>Set Priority Medium for a Standard or untiered case</label>
        <locationX>300</locationX>
        <locationY>950</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_Stamp_Entitlement</name>
        <label>Is there an active entitlement to stamp</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <defaultConnector>
            <targetReference>Decision_Case_Calendar</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No_Active_Entitlement_Or_Case_Already_Stamped</defaultConnectorLabel>
        <rules>
            <name>Active_Entitlement_Found_And_Case_Unstamped</name>
            <label>Active entitlement found and the Case carries none</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Entitlement.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EntitlementId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_Case_Entitlement</targetReference>
            </connector>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Case_Calendar</name>
        <label>Which business hours calendar does this Case follow</label>
        <locationX>176</locationX>
        <locationY>470</locationY>
        <defaultConnector>
            <targetReference>Decision_Derive_Priority</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Calendar_Already_Set_On_The_Case</defaultConnectorLabel>
        <rules>
            <name>Region_EMEA_Calendar_Unset</name>
            <label>Account region is EMEA and the Case has no calendar</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EMEA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BusinessHoursId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_EMEA_Support_Calendar</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Region_US_Calendar_Unset</name>
            <label>Account region is US and the Case has no calendar</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Region__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>US</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BusinessHoursId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_US_Support_Calendar</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Region_Unknown_Calendar_Unset</name>
            <label>No account region on file, so the documented US fallback applies</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Region__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.BusinessHoursId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_US_Support_Calendar</targetReference>
            </connector>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Derive_Priority</name>
        <label>May this Case's Priority be written, and to what</label>
        <locationX>176</locationX>
        <locationY>830</locationY>
        <defaultConnectorLabel>Priority_Entered_By_A_Human_Is_Kept</defaultConnectorLabel>
        <rules>
            <name>Severity_1_Or_Premier_And_Priority_Writable</name>
            <label>Severity 1 or Premier account, on a channel this flow may write</label>
            <conditionLogic>(1 OR 2 OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email-Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email-Billing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Severity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Severity 1</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Support_Tier__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Premier</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_Priority_High</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Standard_Or_Untiered_And_Priority_Writable</name>
            <label>Every other case on a channel this flow may write</label>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email-Support</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email-Billing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_Priority_Medium</targetReference>
            </connector>
        </rules>
    </decisions>
    <description>Before-save on Case create. Stamps EntitlementId and BusinessHoursId only where the field is null (assumption A2), and derives Priority from Severity__c and Account.Support_Tier__c, overwriting the Email-to-Case intake default on the Email-Support and Email-Billing origins per decisions.md D-M3S03-02 option 2, approved at the milestone:M3 gate. No recordCreates, recordUpdates, recordDeletes, actionCalls or subflows by design. Owner: Service Operations (role named at Q90; the individual is OPEN at the M4 gate, as in D-M4S01-02). triggerOrder 10 in the Case before-save context.</description>
    <environments>Default</environments>
    <interviewLabel>Case BeforeSave StampEntitlementAndCalendar {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case BeforeSave Stamp Entitlement And Calendar</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get the Case account and its region and support tier</label>
        <locationX>176</locationX>
        <locationY>110</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Active_Entitlement</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Decision_Case_Calendar</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Region__c</queriedFields>
        <queriedFields>Support_Tier__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Active_Entitlement</name>
        <label>Get the account's active entitlement</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Stamp_Entitlement</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Decision_Case_Calendar</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Account.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Entitlement</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_EMEA_Support_Calendar</name>
        <label>Get the EMEA Support business hours record</label>
        <locationX>50</locationX>
        <locationY>590</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assignment_Case_Calendar_EMEA</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Decision_Derive_Priority</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>EMEA Support</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BusinessHours</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_US_Support_Calendar</name>
        <label>Get the US Support business hours record</label>
        <locationX>300</locationX>
        <locationY>590</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assignment_Case_Calendar_US</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Decision_Derive_Priority</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>US Support</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BusinessHours</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>10</triggerOrder>
</Flow>
