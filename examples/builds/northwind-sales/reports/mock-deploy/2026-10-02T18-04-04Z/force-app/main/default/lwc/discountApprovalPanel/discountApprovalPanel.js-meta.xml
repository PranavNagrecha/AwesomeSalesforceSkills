<?xml version="1.0" encoding="UTF-8"?>
<!--
  discountApprovalPanel.js-meta.xml - build northwind-sales, step M3-S04.

  Element order and every tag below are copied from
  skills/lwc/lwc-app-builder-config/references/code-examples.md section 1 (`pipelineSummary`)
  and skills/lwc/lwc-base-component-recipes/references/code-examples.md
  (`accountSummaryPanel.js-meta.xml`): apiVersion, isExposed, masterLabel, description,
  targets, then one targetConfig holding objects, property, supportedFormFactors in that
  order.

  apiVersion 62.0. The step's inputs{} carry no api_version, so it was resolved by
  agents/lwc-builder/AGENT.md Step 6's order: no sibling LWC bundle exists in this build and
  the repo has no sfdx-project.json, so the value comes from the build itself - all nine
  package.xml files under artefacts/ declare <version>62.0</version>, and the four authored
  Apex classes of M3-S03 (including the controller this component imports) are pinned at
  62.0 by plan decision D-M3S03-01. 62.0 is above the 58.0 floor below which the platform
  treats a bundle as 58.0 anyway (lwc_guide L4697, L4701), and base components are not
  versioned, so nothing in this bundle is rolled back by it.
-->
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Discount Approval Panel</masterLabel>
    <description>Shows the opportunity discount and its approval status, and submits the deal for manager approval when the discount is above the policy threshold.</description>

    <targets>
        <target>lightning__RecordPage</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <!--
              Scoped to Opportunity. Omitting <objects> is not a neutral default: the
              component would become droppable on every UI-API-supported object
              (lwc_guide L19363), and this one reads Discount__c and Approval_Status__c,
              which exist nowhere else. One-way door: an <object> cannot be removed while
              the component is in use on that object's record page (L9905).
            -->
            <objects>
                <object>Opportunity</object>
            </objects>

            <!--
              The threshold is a design attribute, not a literal in the JavaScript, because
              the same number is expressed two different ways in this build (plan decision D8,
              assumption A35): 0.20 in the Opportunity_Discount_Requires_Approval validation
              rule and in the Discount_Approval approval process entry criteria, both of which
              are formula context, and 20 here, which is not. Exposing it is what makes the
              one number that could be silently wrong visible to an admin.

              type="Integer" is one of the three types a lightning__RecordPage targetConfig
              accepts - Boolean, Integer, String (lwc_guide L18972-L18975). No min/max: those
              are a one-way door (they cannot be changed while the component is in use,
              L9907), and no requirement fixes a legal range.
            -->
            <property
                name="discountThreshold"
                type="Integer"
                label="Discount approval threshold (%)"
                description="Approval is required above this discount percentage. Keep it in step with the Opportunity_Discount_Requires_Approval validation rule and the Discount_Approval approval process, which express the same threshold in formula context as 0.20."
                default="20"/>

            <!--
              Large and Small only, per assumption A17 (Q51's default, unanswered at G1):
              Lightning Experience desktop and the Salesforce mobile app, no Experience Cloud.
              Small is safe here because this bundle contains no lightning-datatable and no
              lightning-tree-grid, neither of which is supported on mobile (lwc_guide L5600).
              One-way door: form factors can only be added later, never removed (L9806, L9909).
            -->
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
