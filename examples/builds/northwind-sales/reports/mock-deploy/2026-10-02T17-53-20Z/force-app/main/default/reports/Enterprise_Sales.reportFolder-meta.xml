<?xml version="1.0" encoding="UTF-8"?>
<ReportFolder xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- M4-S02. Q25: shared to the Enterprise Managers public group with View; reps get no access (A31).
         Shape from skills/admin/reports-and-dashboards/references/metadata-examples.md section 4.
         Folder access is not record access: which rows a viewer sees is still decided by sharing. -->
    <accessType>Shared</accessType>
    <name>Enterprise Sales</name>
    <folderShares>
        <accessLevel>View</accessLevel>
        <sharedTo>Enterprise_Managers</sharedTo>
        <sharedToType>Group</sharedToType>
    </folderShares>
</ReportFolder>
