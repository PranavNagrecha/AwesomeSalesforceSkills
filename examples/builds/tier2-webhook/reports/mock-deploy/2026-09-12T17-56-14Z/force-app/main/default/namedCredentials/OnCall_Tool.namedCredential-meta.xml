<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>On-Call Tool</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>

    <!-- The endpoint. Same API name in every org; different parameterValue per org (Q25, A7).
         Production and sandbox share this host and differ only in the key entered in Setup. -->
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://api.oncall.example/v1/salesforce/escalations</parameterValue>
        <description>The on-call tool's inbound events endpoint. The API name stays identical in every org; only this value differs.</description>
    </namedCredentialParameters>

    <!-- The link to OnCall_Tool_EC. externalCredential is a child of the parameter,
         not a top-level field of NamedCredential. -->
    <namedCredentialParameters>
        <parameterName>OnCallToolAuth</parameterName>
        <parameterType>Authentication</parameterType>
        <externalCredential>OnCall_Tool_EC</externalCredential>
    </namedCredentialParameters>

    <calloutStatus>Enabled</calloutStatus>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
</NamedCredential>
