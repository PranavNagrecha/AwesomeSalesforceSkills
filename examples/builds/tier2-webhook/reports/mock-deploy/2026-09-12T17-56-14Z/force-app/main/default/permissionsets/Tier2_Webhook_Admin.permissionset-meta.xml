<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Tier 2 Webhook Admin</label>
    <description>Grants the OnCall_Tool_EC named principal, Integration_Failure__c CRUD/FLS and Tier2_Escalation__e Create/Read (S2-F-13). Assign to every user who can escalate a Case to Tier 2 and to the hourly health-check scheduler (D14).</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- ExternalCredential file stem, a dash, and the NamedPrincipal parameterName. -->
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>OnCall_Tool_EC-OnCallToolNamedPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>

    <!-- Integration_Failure__c only. No objectPermissions row for Case: assumption A14. -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Integration_Failure__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- S2-F-13 (mock-deploy run 8): at API 67.0 EventBus.publish runs in user mode and requires
         Create on the published event; Read is written alongside it only because
         check_permission_set_architecture.py's dependency chain requires allowRead for
         allowCreate (allowEdit/allowDelete are inapplicable to an immutable event stream and are
         written false). Same D14 assignee population that already holds this set: the publish
         call runs in Tier2EscalationService, in the same escalating transaction and as the same
         user whose Case save moved ownership to Tier_2_Engineering. -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Tier2_Escalation__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Tier2_Notified_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Attempt_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Case_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Case__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Endpoint__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Error_Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.HTTP_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Last_Attempted_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Request_Payload__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Resend__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Response_Body__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Severity__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
