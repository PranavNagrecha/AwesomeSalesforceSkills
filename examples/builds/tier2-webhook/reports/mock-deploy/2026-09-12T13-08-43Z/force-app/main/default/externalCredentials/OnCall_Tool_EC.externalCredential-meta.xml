<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>On-Call Tool Credential</label>
    <description>Auth for the on-call tool webhook. The API key is entered in Setup against the principal after deploy, never in this file.</description>
    <authenticationProtocol>Custom</authenticationProtocol>

    <!-- The principal. parameterName here is the principal NAME that Tier2_Webhook_Admin grants. -->
    <externalCredentialParameters>
        <parameterName>OnCallToolNamedPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
        <description>Single shared service identity for every Salesforce user who escalates a Case.</description>
    </externalCredentialParameters>

    <!-- The custom header the platform adds at callout time. parameterValue reads the ApiKey
         authentication parameter entered in Setup against the principal above; the key itself
         never appears in metadata. See deploy-order.md section 5 item 1. -->
    <externalCredentialParameters>
        <parameterName>X-API-Key</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.OnCall_Tool_EC.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
        <description>Header sent on every callout through a Named Credential that references this EC.</description>
    </externalCredentialParameters>
</ExternalCredential>
