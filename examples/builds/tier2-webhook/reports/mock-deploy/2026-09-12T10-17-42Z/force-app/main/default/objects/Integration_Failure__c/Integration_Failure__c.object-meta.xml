<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Audit row for every Tier 2 escalation webhook attempt: endpoint, status, payload and outcome. Written by the escalation Apex; a Support Engineering admin triages and re-sends from it.</description>
    <enableBulkApi>true</enableBulkApi>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Integration Failure</label>
    <nameField>
        <displayFormat>IF-{00000000}</displayFormat>
        <label>Integration Failure Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Integration Failures</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>
