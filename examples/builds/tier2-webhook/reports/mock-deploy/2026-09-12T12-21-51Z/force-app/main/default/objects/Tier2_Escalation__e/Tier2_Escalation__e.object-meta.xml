<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Business event: a Case was escalated to the Tier 2 Engineering queue. Consumed by the external ops dashboard over the Pub/Sub API.</description>
    <eventType>HighVolume</eventType>
    <label>Tier 2 Escalation</label>
    <pluralLabel>Tier 2 Escalations</pluralLabel>
