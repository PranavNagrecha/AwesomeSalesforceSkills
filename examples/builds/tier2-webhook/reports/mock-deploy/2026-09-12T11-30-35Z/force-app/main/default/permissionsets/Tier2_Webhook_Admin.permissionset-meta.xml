<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Tier 2 Webhook Admin</label>
    <description>Grants the OnCall_Tool_EC named principal plus Integration_Failure__c CRUD and FLS. Assign to every user who can escalate a Case to Tier 2 and to the hourly health-check scheduler (D14).</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- ExternalCredential file stem, a dash, and the NamedPrincipal parameterName. -->
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>OnCall_Tool_EC-OnCallToolNamedPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>

    <!-- Integration_Failure__c only. No objectPermissions row for Case: assumption A14. -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Integration_Failure__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Tier2_Notified_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Attempt_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Case_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Case__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Endpoint__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Error_Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.HTTP_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Last_Attempted_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Request_Payload__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Resend__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Response_Body__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Integration_Failure__c.Severity__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
