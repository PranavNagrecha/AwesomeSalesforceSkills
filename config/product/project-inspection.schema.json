{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfskills.dev/schemas/product/project-inspection.schema.json",
  "title": "SfSkills Salesforce Project Inspection Result",
  "type": "object",
  "required": ["discovery"],
  "additionalProperties": false,
  "properties": {
    "discovery": {
      "type": "object",
      "required": ["status", "mode", "found", "package_directories", "candidates", "warnings"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["found", "standalone", "ambiguous", "invalid"]
        },
        "mode": {
          "enum": ["explicit", "cwd", "workspace", "standalone"]
        },
        "found": {"type": "boolean"},
        "project_root": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"], "description": "Alias of project_root"},
        "descriptor_path": {"type": ["string", "null"]},
        "sfdx_project_json": {"type": ["string", "null"], "description": "Alias of descriptor_path"},
        "namespace": {"type": ["string", "null"]},
        "source_api_version": {"type": ["string", "null"]},
        "package_directories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["declared_path", "absolute_path", "default", "exists"],
            "additionalProperties": false,
            "properties": {
              "declared_path": {"type": "string"},
              "absolute_path": {"type": "string"},
              "default": {"type": "boolean"},
              "exists": {"type": "boolean"}
            }
          }
        },
        "candidates": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mapping": {
      "type": "object",
      "required": ["status", "component_type", "full_name", "matches", "searched_patterns", "warnings"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["mapped", "not_found", "unsupported_type", "standalone", "project_unavailable", "invalid_component"]
        },
        "component_type": {"type": "string"},
        "full_name": {"type": "string"},
        "project_root": {"type": ["string", "null"]},
        "searched_patterns": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "relative_path", "package_directory"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "relative_path": {"type": "string"},
              "package_directory": {"type": "string"},
              "line": {"type": ["integer", "null"], "minimum": 1},
              "column": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        }
      }
    }
  }
}
