{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfskills.local/schemas/source-integration.schema.json",
  "title": "SfSkills Source Integration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "integration_id",
    "created_at",
    "baseline",
    "sources",
    "decisions",
    "changed_files",
    "validation",
    "attestation"
  ],
  "properties": {
    "$schema": {
      "const": "../../config/source-integration.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "integration_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": {
      "type": "string"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_archive",
        "reviewed_archive",
        "reviewed_archive_sha256",
        "exact_requested_snapshot_available",
        "repository_baseline_commit",
        "notes"
      ],
      "properties": {
        "requested_archive": {
          "type": "string"
        },
        "reviewed_archive": {
          "type": "string"
        },
        "reviewed_archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exact_requested_snapshot_available": {
          "type": "boolean"
        },
        "repository_baseline_commit": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requested_archive",
          "repository",
          "pin",
          "license",
          "candidate_count",
          "content_use"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "requested_archive": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "pin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value",
              "reason"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "commit",
                  "tag",
                  "archive-sha256",
                  "unavailable"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detected",
              "class",
              "conflict",
              "conflict_reason",
              "evidence"
            ],
            "properties": {
              "detected": {
                "type": "string"
              },
              "class": {
                "type": "string",
                "enum": [
                  "permissive",
                  "clean-room",
                  "rejected"
                ]
              },
              "conflict": {
                "type": "boolean"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "conflict_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "conflict": {
                      "const": true
                    }
                  },
                  "required": [
                    "conflict"
                  ]
                },
                "then": {
                  "properties": {
                    "conflict_reason": {
                      "type": "string",
                      "minLength": 20
                    }
                  }
                },
                "else": {
                  "properties": {
                    "conflict_reason": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 1
          },
          "content_use": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "candidate_id",
          "disposition",
          "target",
          "scope",
          "rationale",
          "routing",
          "files"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "ADD",
              "DEEPEN",
              "MERGE",
              "STOP",
              "DEFER",
              "REJECT"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 12
          },
          "rationale": {
            "type": "string",
            "minLength": 20
          },
          "routing": {
            "type": "string",
            "minLength": 12
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "changed_files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_room",
        "no_unverified_copy",
        "product_boundary"
      ],
      "properties": {
        "clean_room": {
          "type": "string",
          "minLength": 20
        },
        "no_unverified_copy": {
          "type": "boolean"
        },
        "product_boundary": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
