<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- RPT-DASH-SORT-01 negative: the Column chart carries <sortBy>; the Metric, Gauge and Table
         components carry none and are not charts. Expect 0 findings. -->
    <backgroundEndColor>#FFFFFF</backgroundEndColor>
    <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <dashboardType>LoggedInUser</dashboardType>
    <leftSection>
        <columnSize>Wide</columnSize>
        <components>
            <autoselectColumnsFromReport>false</autoselectColumnsFromReport>
            <chartAxisRange>Auto</chartAxisRange>
            <chartSummary>
                <aggregate>Sum</aggregate>
                <axisBinding>y</axisBinding>
                <column>AMOUNT</column>
            </chartSummary>
            <componentType>Column</componentType>
            <displayUnits>Auto</displayUnits>
            <groupingColumn>CLOSE_DATE</groupingColumn>
            <header>Open pipeline</header>
            <legendPosition>Bottom</legendPosition>
            <report>Sales_Fixture/Open_Pipeline</report>
            <showValues>true</showValues>
            <sortBy>RowLabelAscending</sortBy>
            <title>By close month</title>
            <useReportChart>false</useReportChart>
        </components>
    </leftSection>
    <middleSection>
        <columnSize>Medium</columnSize>
        <components>
            <componentType>Gauge</componentType>
            <displayUnits>Auto</displayUnits>
            <gaugeMax>1000000.0</gaugeMax>
            <gaugeMin>0.0</gaugeMin>
            <header>Quarter target</header>
            <report>Sales_Fixture/Open_Pipeline</report>
            <useReportChart>false</useReportChart>
        </components>
        <components>
            <componentType>Table</componentType>
            <displayUnits>Auto</displayUnits>
            <header>Top deals</header>
            <report>Sales_Fixture/Open_Pipeline</report>
            <useReportChart>false</useReportChart>
        </components>
    </middleSection>
    <rightSection>
        <columnSize>Narrow</columnSize>
        <components>
            <componentType>Metric</componentType>
            <displayUnits>Auto</displayUnits>
            <header>Total open</header>
            <metricLabel>Open pipeline</metricLabel>
            <report>Sales_Fixture/Open_Pipeline</report>
            <useReportChart>false</useReportChart>
        </components>
    </rightSection>
    <textColor>#000000</textColor>
    <title>Pipeline Sorted</title>
    <titleColor>#000000</titleColor>
    <titleSize>12</titleSize>
</Dashboard>
