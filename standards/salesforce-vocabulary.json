  "_meta": {
    "version": "1.0",
    "purpose": "Bidirectional Salesforce vocabulary map. Used by scripts/query_enrichment.py to expand abbreviations and acronyms in user queries before lexical retrieval. Each key is the abbreviation; values are equivalent phrases. The map is bidirectional at runtime — queries containing the abbreviation get the long forms appended, and queries containing a long form get the abbreviation appended.",
    "scope_rules": "Add an entry only if (1) the abbreviation is canonical Salesforce vernacular, (2) the abbreviation is unambiguous in Salesforce context (no English-language collision with a different meaning), and (3) at least 3 skills' descriptions/triggers/tags use BOTH the abbrev and a long form interchangeably.",
    "expansion_rules": "Expansion only applies when the abbreviation appears as a standalone token (whitespace or string boundary on both sides). Never embed inside a larger word. Bidirectional: long-form match adds the abbrev as a single token.",
    "sources": "Salesforce Help glossary, Salesforce Architects glossary, the repo's standards/, and the skill corpus tags/triggers."
  },
