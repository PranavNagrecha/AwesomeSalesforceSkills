  "id": "P07",
  "inputs": [
    {
      "description": "Org, project, package, object set, or security domain",
      "name": "scope",
      "requirement": "required"
    },
    {
      "description": "Local project",
      "name": "project_path",
      "requirement": "optional"
    },
    {
      "description": "Read-only org",
      "name": "target_org",
      "requirement": "optional"
    },
    {
      "description": "Framework default or approved organization policy",
      "name": "policy_profile",
      "requirement": "optional"
    }
  ],
  "known_limitations": [
    "Not a penetration test or compliance certification",
    "Cannot inspect encrypted secrets",
    "Managed-package internals may be unavailable"
  ],
