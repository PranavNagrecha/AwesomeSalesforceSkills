{
  "$schema": "../../schemas/product.schema.json",
  "agent_ids": [
    "sf-context-librarian",
    "sf-project-inspector",
    "sf-org-grounder",
    "release-readiness-reviewer",
    "sf-evidence-reviewer"
  ],
  "command_ids": [
    "review-release-readiness"
  ],
  "context_policy": {
    "core_files_max": 5,
    "core_files_min": 3,
    "hard_total_files": 12,
    "max_tool_page_bytes": 32768,
    "target_total_files": 8,
    "transcript_handoff": false
  },
  "evidence_policy": {
    "contradictions_preserved": true,
    "material_claims_require_evidence": true,
    "skill_does_not_prove_target_state": true
  },
  "finding_types": [
    "hard blockers",
    "risk-ranked concerns",
    "test and validation coverage",
    "deployment ordering",
    "environment prerequisites",
    "rollback gaps",
    "go/no-go/conditional recommendation"
  ],
  "id": "P06",
  "inputs": [
    {
      "description": "Manifest, Git diff/range, package directory, or structured change list",
      "name": "release_scope",
      "requirement": "required"
    },
    {
      "description": "Salesforce DX project",
      "name": "project_path",
      "requirement": "optional"
    },
    {
      "description": "Read-only validation target",
      "name": "target_org",
      "requirement": "optional"
    },
    {
      "description": "Conservative/default/aggressive with explicit policy",
      "name": "risk_tolerance",
      "requirement": "optional"
    }
  ],
  "known_limitations": [
    "Does not approve business readiness or organizational change",
    "Cannot validate unavailable external systems",
    "A release can remain conditional despite high technical quality"
  ],
  "known_truth_scenarios": [
    "REL-MISSING-DEPENDENCY",
    "REL-TEST-GAP",
    "REL-SECURITY-RISK",
    "REL-DATA-SEQUENCING",
    "REL-DRIFT",
    "REL-ROLLBACK-GAP"
  ],
  "lifecycle_status": "beta target",
  "optional_evidence": [
    "deployment validation result",
    "Apex/Flow tests",
    "code analysis",
    "dependencies",
    "permissions",
    "data migration plan",
    "rollback/runbook",
    "environment drift"
  ],
  "permissions": [
    "repository.read",
    "knowledge.read",
    "local_reports.write",
    "salesforce.read"
  ],
  "personas": [
    "release-engineer",
    "architect",
    "developer",
    "consultant",
    "security-reviewer"
  ],
  "quality_gates": [
    "Readiness is evidence-specific, not a generic score",
    "Missing validation cannot produce unconditional go",
    "Recommendations map to release components",
    "No deployment execution"
  ],
  "required_evidence": [
    "Versioned release scope"
  ],
  "slug": "release-readiness-review",
  "supported_modes": [
    "fixture",
    "local-project",
    "live-read-only",
    "hybrid",
    "scratch-qa"
  ],
  "title": "Release Readiness Review",
  "tool_ids": [
    "get_deployment_result",
    "get_apex_test_run",
    "get_code_analysis_result",
    "get_component_dependency_evidence",
    "get_org_snapshot_manifest",
    "get_flow_test_result"
  ],
  "user_job": "Given a release scope, tell me whether it is ready, what blocks it, what should be tested or sequenced, and what evidence is still missing.",
  "version": "0.9.0"
}
