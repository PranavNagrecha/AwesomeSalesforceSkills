{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfskills.local/agents/data-migration-reconciler/inputs.schema.json",
  "title": "data-migration-reconciler inputs",
  "type": "object",
  "properties": {
    "result_path": {
      "type": "string",
      "description": "Path to captured JSON fixture."
    },
    "item_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "target_org": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "migration_manifest": {
      "type": "string"
    },
    "result_files": {
      "type": "string"
    }
  },
  "required": [
    "migration_manifest",
    "result_files"
  ]
}
