  "title": "integration-incident-triager inputs",
  "type": "object",
  "properties": {
    "result_path": {
      "type": "string",
      "description": "Path to captured JSON fixture."
    },
    "item_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "target_org": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "integration": {
      "type": "string"
    },
    "time_window": {
      "type": "string"
    }
  },
  "required": [
