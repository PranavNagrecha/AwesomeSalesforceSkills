{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfskills.local/agents/access-path-explainer/inputs.schema.json",
  "title": "access-path-explainer inputs",
  "type": "object",
  "properties": {
    "result_path": {
      "type": "string",
      "description": "Path to captured JSON fixture."
    },
    "item_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "target_org": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    }
  },
  "required": [
    "user",
    "resource",
    "operation"
  ]
}
