{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfskills.local/agents/change-impact-planner/inputs.schema.json",
  "title": "change-impact-planner inputs",
  "type": "object",
  "properties": {
    "result_path": {
      "type": "string",
      "description": "Path to captured JSON fixture."
    },
    "item_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "target_org": {
      "type": "string"
    },
    "project_path": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "proposed_change": {
      "type": "string"
    }
  },
  "required": [
    "component",
    "proposed_change"
  ]
}
