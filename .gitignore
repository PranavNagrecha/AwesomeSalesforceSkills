.DS_Store
__pycache__/
*.pyc
*.pyo

# lexical.sqlite grows past GitHub's 50 MB limit — regenerate with: python3 scripts/skill_sync.py --all
vector_index/lexical.sqlite

# chunks.jsonl crosses GitHub's 50 MB warning threshold (~98 MB at 690 skills
# and growing). Regenerate locally or in CI via `python3 scripts/build_index.py`
# before any validation or drift check. registry/ + vector_index/manifest.json
# stay committed — they encode the content hash that detects rebuild drift,
# so CI can verify reproducibility without the raw bytes.
vector_index/chunks.jsonl

# embeddings.jsonl holds 384-dim fastembed vectors for every chunk
# (~500 MB at 120K chunks). Same pattern as chunks.jsonl — regenerate via
# `python3 scripts/skill_sync.py --all`. The content_hash on each record
# enables incremental re-encode of only changed chunks on subsequent runs.
vector_index/embeddings.jsonl

# skill_embeddings.jsonl holds one 384-dim vector per skill (~3 MB at 994
# skills). Built ~100x faster than chunk-level embeddings.jsonl and useful
# as a lightweight semantic-rerank signal when chunk-level isn't available.
# Regenerate via `python3 scripts/build_skill_embeddings.py`.
vector_index/skill_embeddings.jsonl

# Export tree is a generated artifact (~130 MB for claude+mcp+cursor+windsurf+
# aider+augment at 684 skills). Consumers regenerate via:
#   python3 scripts/export_skills.py --all
# The committed registry/export_manifest.json records per-target content hashes
# so CI parity checks don't need the bytes — just the hashes.
exports/

# Claude Code worktrees (temporary agent working copies)
.claude/worktrees/

# Codex ↔ Claude Code handoff zone: raw skill file drops (=== FILE: ... ===
# format) that Claude Code picks up, writes into the tree, syncs, validates,
# and commits. Processed files go under _codex_drops/processed/. The zone
# itself is tracked (README + prompt) but individual drops are not.
_codex_drops/*.txt
_codex_drops/*.out
_codex_drops/processed/

# Per-run reports generated by scripts/run_builder.py — each gated run writes
# REQUIREMENTS.md, state.json, envelope.json, report.md under
# docs/reports/<agent>/<run_id>/. Transient CI/debug artifacts; regenerate via:
#   python3 scripts/run_builder.py --agent <agent> --fixture <...> --emitted-dir <...>
docs/reports/

# scripts/execute_agent_fixture.py debug artifact — the assembled prompt sent
# to the model. Reproducible from the fixture + agent source, ~37 KB per run,
# noisy to diff. The raw.md (model response), envelope.json (extracted
# envelope), and grade.txt (grader verdict) alongside it ARE committed as the
# persistent record of each agent execution.
docs/validation/agent_executions_*/*.prompt.txt

# Local Claude Code session state (user-specific, not part of repo)
.claude/

# Session artifacts from eval / build / audit runs.
# The harness scripts under evals/measurement/*.py STAY committed (reusable
# tooling). Their per-session OUTPUTS do not — they are dated, noisy in diff,
# and easily regenerated by re-running the script. If you want to reference
# a past session's output, archive it under /tmp or a personal scratch dir.
#
# Pattern reasoning: anything that ends in a dated report or per-loop dump
# belongs in this list. New report types should be added here, not committed.
evals/measurement/REPORT.md
evals/measurement/SESSION_REPORT.md
evals/measurement/REMEDIATION_PLAN.md
evals/measurement/EXISTING_SKILL_QUALITY_AUDIT.md
evals/measurement/gap_themes.md
evals/measurement/gap_screening_report.md
evals/measurement/competitive_*.md
evals/measurement/loop[0-9]*_*.json
evals/measurement/loop[0-9]*_*.md
evals/measurement/per_row.jsonl

# Multi-agent scaffold churn — when /build-skills or similar batch commands
# run, sub-agents may shuffle scaffolds between skills/ and .planning/ during
# authoring. Final skills go under skills/; partial work-in-progress is local
# until it's ready to ship via a normal /new-skill commit.
.planning/scaffolds-pending/

# Per-session metrics for the agentic build commands. Local-only history of
# which skills got built, agent failure rates, build durations. Used by
# /build-skills to track its own performance over time and improve, but never
# part of the production product.
.planning/build-history/

# Pre-prod / content QA session artifacts. The harness scripts under
# .planning/qa-execution/*.py are reusable but per-session in nature; their
# raw JSON results + venv + dated plan/report markdown are NOT product
# artifacts. Keep them local — they're easy to regenerate by re-running the
# harness against the target org.
.planning/qa-execution/
.planning/qa-*.md
.qa-venv/

# Per-machine venvs spun up by the v0.4.4 publish gate (L0-2 / L0-3) and
# similar release smoke-tests. Regenerated on every wheel build; never
# belong in the repo.
.build-venv/
.smoke-venv/
.verify-venv/

# `python -m build` output. Wheels + sdists are uploaded to PyPI from
# `mcp/sfskills-mcp/dist/` and don't need to live in git.
mcp/sfskills-mcp/dist/

# Pip's editable-install metadata bundle (`pip install -e .` writes this).
# Per-machine, regenerated on every install — never belongs in the repo.
*.egg-info/
